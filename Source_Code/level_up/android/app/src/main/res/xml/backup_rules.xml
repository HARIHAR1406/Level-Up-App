<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android API 23–30 (fullBackupContent).
  Level Up is an offline-first app whose data must NOT survive
  uninstall/reinstall. Exclude everything from Auto Backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>

